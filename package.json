{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:static": "playwright test --config=playwright.static.config.ts",
    "test:e2e:static:a11y": "playwright test --config=playwright.static.config.ts --project=chromium-a11y",
    "test:e2e:static:chromium": "playwright test --config=playwright.static.config.ts --project=chromium",
    "test:e2e:static:visual": "playwright test --config=playwright.static.config.ts --project=chromium-visual",
    "test:e2e:static:webkit": "playwright test --config=playwright.static.config.ts --project=webkit",
    "test:e2e:ui": "playwright test --ui",
    "preview:static": "node --experimental-strip-types scripts/serve-static.mts",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hast-util-to-string": "3.0.1",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "4.6.0",
    "three": "^0.187.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vfile-matter": "5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
